# Dargent environment configuration
# Copy to .env and adjust for your environment

# Database
DARGENT_DB_HOST=postgres
DARGENT_DB_PORT=5432
DARGENT_DB_NAME=dargent
DARGENT_DB_USER=dargent
DARGENT_DB_PASSWORD=dargent

# PIX profile (static per deployment)
DARGENT_PIX_PROFILE_PIX_KEY=your-pix-key
DARGENT_PIX_PROFILE_RECEIVER_NAME=Your Company
DARGENT_PIX_PROFILE_RECEIVER_CITY=SAOPAULO

# PSP integration
DARGENT_PSP_BASE_URL=http://psp-simulator:8090
DARGENT_PSP_CREATE_MAX_ATTEMPTS=3
DARGENT_PSP_CREATE_BACKOFF_BASE_MS=20
DARGENT_PSP_WEBHOOK_SECRET=dev-only-secret
DARGENT_PSP_CALLBACK_URL=http://api-blue:8080/webhooks/psp

# PIX profile for BR Code generation
DARGENT_PIX_PROFILE_PIX_KEY=your-pix-key
DARGENT_PIX_PROFILE_RECEIVER_NAME=Your Company
DARGENT_PIX_PROFILE_RECEIVER_CITY=SAOPAULO

# Relay (E6)
DARGENT_RELAY_ENABLED=false
DARGENT_RELAY_WORKERS=2
DARGENT_RELAY_POLL_MS=1000
DARGENT_RELAY_BATCH=32
DARGENT_OUTBOX_RETENTION_DAYS=7

# Events (E6)
DARGENT_EVENTS_PUBLISH_TIMEOUT_MS=2000
DARGENT_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:dargent-payments-events.fifo
DARGENT_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/dargent-payments-notify.fifo
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566

# PIX profile
DARGENT_PIX_PROFILE_PIX_KEY=your-pix-key
DARGENT_PIX_PROFILE_RECEIVER_NAME=Your Company
DARGENT_PIX_PROFILE_RECEIVER_CITY=SAOPAULO