# Dargent environment configuration
# Copy to .env and adjust for your environment

# Database
DARGENT_DB_HOST=postgres
DARGENT_DB_PORT=5432
DARGENT_DB_NAME=dargent
DARGENT_DB_USER=dargent
DARGENT_DB_PASSWORD=dargent

# PIX profile (static per deployment)
DARGENT_PIX_PROFILE_PIX_KEY=your-pix-key
DARGENT_PIX_PROFILE_RECEIVER_NAME=Your Company
DARGENT_PIX_PROFILE_RECEIVER_CITY=SAOPAULO

# PSP integration
DARGENT_PSP_BASE_URL=http://psp-simulator:8090
DARGENT_PSP_CREATE_MAX_ATTEMPTS=3
DARGENT_PSP_CREATE_BACKOFF_BASE_MS=20
PSP_WEBHOOK_SECRET=dev-only-secret
# MUST point at the nginx front (E12 Q26): the simulator calls this URL for webhooks, and either
# api color may serve a request mid-canary. Binds application.yaml `psp.callback-url`.
PSP_CALLBACK_URL=http://nginx:80/webhooks/psp

# Reconciler (E5/E12 Q24 — pass-through; enabled+short interval in the runtime-smoke job only)
DARGENT_RECONCILER_ENABLED=false
DARGENT_RECONCILER_SCAN_MS=60000
DARGENT_RECONCILER_BACKOFF_MS=60000,300000,900000,3600000
DARGENT_RECONCILER_GIVE_UP_HOURS=72
DARGENT_RECONCILER_BATCH=100

# PIX profile for BR Code generation
DARGENT_PIX_PROFILE_PIX_KEY=your-pix-key
DARGENT_PIX_PROFILE_RECEIVER_NAME=Your Company
DARGENT_PIX_PROFILE_RECEIVER_CITY=SAOPAULO

# Relay (E6)
DARGENT_RELAY_ENABLED=false
DARGENT_RELAY_WORKERS=2
DARGENT_RELAY_POLL_MS=1000
DARGENT_RELAY_BATCH=32
DARGENT_OUTBOX_RETENTION_DAYS=7

# Events (E6)
DARGENT_EVENTS_PUBLISH_TIMEOUT_MS=2000
DARGENT_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:dargent-payments-events.fifo
DARGENT_EVENTS_QUEUE_URL=http://localstack:4566/000000000000/dargent-payments-notify.fifo
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566

# PIX profile
DARGENT_PIX_PROFILE_PIX_KEY=your-pix-key
DARGENT_PIX_PROFILE_RECEIVER_NAME=Your Company
DARGENT_PIX_PROFILE_RECEIVER_CITY=SAOPAULO

# Ledger consumer (E7)
DARGENT_LEDGER_CONSUMER_ENABLED=false
DARGENT_LEDGER_QUEUE_URL=http://localstack:4566/000000000000/dargent-payments-ledger.fifo
DARGENT_LEDGER_POLL_MS=1000
DARGENT_LEDGER_BATCH=10