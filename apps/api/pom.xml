<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.dargent</groupId>
    <artifactId>dargent-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <properties>
    <!-- E13 S1: owner-fixed LINE coverage floor (api, testing-playbook §5) — measured on combined unit+IT data. -->
    <jacoco.line.floor>0.40</jacoco.line.floor>
    <jacoco.skip>false</jacoco.skip>
  </properties>


  <artifactId>dargent-api</artifactId>
  <name>Dargent API</name>

  <description>Composition root: wires modules, REST, security, schedulers, messaging adapters (AGENTS.md §2 — no domain logic here).</description>

  <dependencies>
    <dependency>
      <groupId>io.dargent</groupId>
      <artifactId>dargent-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>io.dargent</groupId>
      <artifactId>dargent-payments</artifactId>
    </dependency>
    <dependency>
      <groupId>io.dargent</groupId>
      <artifactId>dargent-ledger</artifactId>
    </dependency>
    <dependency>
      <groupId>io.dargent</groupId>
      <artifactId>dargent-notifications</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
      <!-- Boot 4.x moved Flyway auto-configuration out of spring-boot-autoconfigure into this
           starter (migration guide: "Add technology-specific starters"). Raw flyway-core alone
           silently disables boot-time migration despite spring.flyway.* configuration. -->
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- AWS SDK v2 (SNS/SQS) — SNS publish (relay EventPublisher) and SQS ledger consumer are
         PRODUCTION beans wired in this app's composition configs (E6 §4: sns + sqs authorized);
         compile scope so the runtime image carries them. LocalStack ITs reuse the same clients. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sns</artifactId>
      <version>2.54.13</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>2.54.13</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <version>2.54.13</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>dargent-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <!-- E13 S1: the boot app hosts the hexagonal ITs; this merge writes ONE aggregated exec
               for the whole reactor. The CI coverage step then enforces each module's floor against
               it — adapter lines exercised by ITs count toward the owning module (playbook §5:
               combined unit+IT data, measured after the IT step; design §11.1 `./mvnw jacoco:check`). -->
          <execution>
            <id>jacoco-merge</id>
            <phase>verify</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${maven.multiModuleProjectDirectory}</directory>
                  <includes>
                    <include>**/target/jacoco.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/coverage-aggregate.exec</destFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
