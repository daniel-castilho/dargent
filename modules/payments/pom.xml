<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.dargent</groupId>
    <artifactId>dargent-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>dargent-payments</artifactId>
  <name>Dargent Payments</name>
  <description>Payment lifecycle, idempotency, outbox, webhook intake, reconciliation, refunds (design.md §3.2).</description>

  <dependencies>
    <dependency>
      <groupId>io.dargent</groupId>
      <artifactId>dargent-shared</artifactId>
    </dependency>
    <!-- JPA/Hibernate at the adapter edge only — decision D14; domain stays framework-free
         (ArchUnit + boundary script enforce). spring-context is needed at compile for the
         adapter's @Repository/@Transactional (not pulled by the data-jpa starter itself). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!-- Micrometer for the E11 metric counters (transitions/idempotency/refunds at use-case level,
         gauges at the adapter edge). Version managed by the Boot parent BOM. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <!-- Jackson for adapter JSON serialization (compile scope needed for adapter) -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.1.5</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>3.1.5</version>
    </dependency>
    <!-- Compile dependencies stay framework-free: JPA above already granted by spec §3.3. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Fee-math property tests (spec §3.3): engine coexists with JUnit on junit-platform. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>1.9.2</version>
      <scope>test</scope>
    </dependency>
    <!-- Real-PostgreSQL ITs (spec §3.3) — the adapter contract suite + the race proof. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- WireMock for PSP adapter contract tests (spec §3.4, §5.7) — standalone, test scope only. -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.8.0</version>
      <scope>test</scope>
    </dependency>
    <!-- IT wiring: Flyway (module-owned DDL location) + Boot's @ServiceConnection test support. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- AWS SDK v2 for SNS/SQS (E6 outbox relay); SQS is also compile-scope for the E11 DLQ-depth
         gauge poller (payments adapter), SNS+LocalStack used by ITs to create the topology and
         assert delivery (E6 spec §4: sns + sqs are the only authorized modules). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sns</artifactId>
      <version>2.25.17</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>2.25.17</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <version>2.25.17</version>
    </dependency>
    <!-- LocalStack testcontainer for E6 ITs (Block 2) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-localstack</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
