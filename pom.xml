<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.dargent</groupId>
  <artifactId>dargent-parent</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Dargent Parent</name>
  <description>PIX payment processing and transaction system — modular monolith engineered for extraction</description>

  <modules>
    <module>modules/shared</module>
    <module>modules/payments</module>
    <module>modules/ledger</module>
    <module>modules/notifications</module>
    <module>apps/api</module>
    <module>apps/psp-simulator</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <archunit.version>1.4.1</archunit.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.dargent</groupId>
        <artifactId>dargent-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.dargent</groupId>
        <artifactId>dargent-payments</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.dargent</groupId>
        <artifactId>dargent-ledger</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.dargent</groupId>
        <artifactId>dargent-notifications</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- Boot 4 no longer manages Testcontainers; TC 2.0 BOM (module names gained the testcontainers- prefix). -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
            <failIfNoTests>false</failIfNoTests>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <failIfNoTests>false</failIfNoTests>
          </configuration>
        </plugin>
        <!-- JaCoCo coverage gate (per-module floors, combined unit+IT data) is activated at M4
             per design.md §10.3 — see lessons.md #8 for why it must measure after the IT step. -->
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
