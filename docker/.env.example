# Operator contract — copy to docker/.env and adjust. Twelve-factor: config lives in the environment.
# NEVER commit the real .env (AGENTS.md §4.2).

# Database (PostgreSQL 16 — the source of truth)
DARGENT_DB_HOST=localhost
DARGENT_DB_PORT=5432
DARGENT_DB_NAME=dargent
DARGENT_DB_USER=dargent
DARGENT_DB_PASSWORD=change-me

# AWS SDK v2 against LocalStack (SNS/SQS FIFO)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# PSP simulator (the fake Stripe)
PSP_BASE_URL=http://localhost:8090
PSP_WEBHOOK_SECRET=dev-only-secret

# Simulator chaos knobs (all off by default)
CHAOS_WEBHOOK_DUPLICATE=false
CHAOS_WEBHOOK_DELAY_MS=0
CHAOS_WEBHOOK_DROP_RATE=0.0
CHAOS_PSP_ERROR_RATE=0.0

# Platform policy
DARGENT_FEE_BPS=100
